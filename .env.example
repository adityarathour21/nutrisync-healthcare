# ==========================================
# NutriSync Backend Environment Configuration
# ==========================================
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# Database (MongoDB Atlas URI; falls back safely to persistent local store in dev if unset)
MONGODB_URI=""

# Security & Session JWT
JWT_SECRET="replace_with_strong_random_64_char_secret_in_production"

# Google Gemini API (Server-side only — never expose to browser)
GEMINI_API_KEY=""

# Cloudinary Document & Meal Image Storage (Optional — falls back to local secure storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay Payment Gateway (Test Mode — falls back to verified sandbox checkout if unset)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Google OAuth & Maps Backend
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_MAPS_API_KEY=""

# Nodemailer SMTP Notifications (Optional — logs structured transactional previews if unset)
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="NutriSync Clinical Care <noreply@nutrisync.health>"

# ==========================================
# NutriSync Frontend Environment Variables (Public / Restricted Keys Only)
# ==========================================
VITE_API_URL="/api"
VITE_GOOGLE_CLIENT_ID=""
VITE_GOOGLE_MAPS_API_KEY=""
